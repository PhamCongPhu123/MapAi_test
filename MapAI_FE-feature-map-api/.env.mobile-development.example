# Copy to .env.mobile-development.local. These values are bundled in the app.
# Android Emulator -> backend on your computer (HTTP development profile).
VITE_API_BASE_URL=http://10.0.2.2:5028/api/v1
# Physical Android phone: replace 10.0.2.2 with your computer's Wi-Fi IP.
# VITE_API_BASE_URL=http://192.168.1.10:5028/api/v1
# Optional public browser key. Without it the map uses OpenFreeMap with independent street-map fallbacks.
VITE_MAPTILER_KEY=
